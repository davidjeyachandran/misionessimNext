# Cloudflare Pages redirects. Replaces next.config redirects(), which is
# unsupported under `output: 'export'`. Keep in sync with next.config.ts.
# Format: <source> <destination> <status>  (:splat = matched wildcard).

# Author archives dropped (WP data was only account names) -> blog index.
/blog/author/*        /blog/                       301

# Revista canonical inverted: legacy /la-revista/<slug>/ -> /revistavamos/<slug>/.
/la-revista           /revistavamos/               301
/la-revista/*         /revistavamos/:splat         301
