# Copy to .env.local and fill in values. Never commit .env.local.

# Contentful — same space as mi-movilicemos (~/websites/poc/mi-movilicemos)
# Content Delivery API (read-only, published content) — used at build time and in route handlers
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_MANAGEMENT_TOKEN=

# Contentful on-demand revalidation — secret shared between this app and the Contentful webhook
CONTENTFUL_REVALIDATE_SECRET=

# Contact form (Sirve con SIM). The site is a static export, so the browser POSTs
# straight to a hosted form endpoint. Web3Forms is the one in use; Formspree
# (https://formspree.io/f/<id>, no key) also works with no code change.
#
# The access key is NOT a secret: it is inlined into the client bundle and is
# public by design on every service of this kind — which is why the form ships
# two honeypots (see ContactForm.tsx). Both vars are baked in at build time, so
# changing either needs a redeploy. Leave the endpoint blank and the form is not
# rendered at all, only the email/WhatsApp links beside it.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://api.web3forms.com/submit
NEXT_PUBLIC_CONTACT_ACCESS_KEY=

# Resend — unused while the form posts to a hosted endpoint. Kept for the
# route-handler approach in docs/PROGRESS.md, which needs `output: "export"`
# dropped from next.config.ts first.
RESEND_API_KEY=
CONTACT_FORM_TO_EMAIL=

# Google Analytics 4. Same property the old WordPress site reported to, so the
# history stays continuous. The measurement ID is NOT a secret — it ships in the
# page HTML on every GA install.
#
# Leave it blank and no analytics loads at all, which is what keeps local dev and
# Vercel preview deploys out of the property: set it on the Production
# environment only. The privacy policy reads the same flag, so a blank value also
# removes the cookies section from /privacidad/ (see lib/analytics.ts).
#
# ANALYTICS_RETENTION_MONTHS in lib/analytics.ts is quoted verbatim in the
# policy and must match GA4 Admin -> Data retention.
NEXT_PUBLIC_GA_ID=G-MKMWG4RBXB

# App URL (used by sitemap.ts and metadataBase)
NEXT_PUBLIC_SITE_URL=https://misionessim.org
