# Copy to .env.local and fill in values. Never commit .env.local.

# Contentful — same space as mi-movilicemos (~/websites/poc/mi-movilicemos)
# Content Delivery API (read-only, published content) — used at build time and in route handlers
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_MANAGEMENT_TOKEN=

# Contentful on-demand revalidation — secret shared between this app and the Contentful webhook
CONTENTFUL_REVALIDATE_SECRET=

# Resend — transactional email for the contact form route handler
RESEND_API_KEY=
CONTACT_FORM_TO_EMAIL=

# App URL (used by sitemap.ts and metadataBase)
NEXT_PUBLIC_SITE_URL=https://misionessim.org
